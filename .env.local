CACHE_WARMING_ENABLED=true
CACHE_WARMING_INTERVAL_SECONDS=60
AI_RESPONSE_CACHE_TTL_SECONDS=3600
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth0 Configuration
