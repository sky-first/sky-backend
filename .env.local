RATE_LIMIT_ENABLED=false

# Google SSO Configuration
GOOGLE_CLIENT_ID=339934531036-1i4fe0v25t66pqhkoqe9jjnu7f3uhcd8.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:3000/login/sso/callback

# Required for Pydantic Settings validation
JWT_SECRET_KEY=217a0c91c59bfeec95a3de24c6c1a5132bbc349f8bed90f15ca30f70d726ca4c
ENCRYPTION_KEY=32-byte-secret-key-for-local-dev-only-!!

# DEMO_PG_HOST=<rds-endpoint>.rds.amazonaws.com   # preencher quando RDS estiver provisionado
DEMO_PG_HOST=
DEMO_PG_PORT=5432
DEMO_PG_DB=postgres
DEMO_PG_USER=demo_reader
DEMO_PG_PASSWORD=4T3Ybyp2d9zN6vwRUhkK6FucI

# Public demo signup — turn on locally so /demo/signup provisions
# guest users instead of returning 'Public demo is currently disabled'.
# Cloudflare Turnstile is auto-skipped when TURNSTILE_SECRET_KEY is empty.
DEMO_ENABLED=true

# Pre-seeded Postgres connections shared with every per-visitor demo
# sandbox at signup time. UUIDs from data_connections table — created
# by scripts/seed_demo_connections.py. Without this list demo Spaces
DEMO_DATASET_CONNECTION_IDS=5d428ff3-b40b-4aa3-9d0e-e879e627bf84,9b771d6a-7dc1-4155-b40d-959fe5a08fbc,32527d3b-7020-482d-8de7-7ee8904799f9,9f352925-0937-4f30-b7e1-d833ff37ff4d,1d39f8c9-5397-464d-b014-15502e970bc2

# Console access — Sky-team members (any @skyfirstlabs.com that logs in via SSO)
CONSOLE_ALLOWED_EMAILS=gustavo.mendonca@skyfirstlabs.com,kaique.mendonca@skyfirstlabs.com,lucas@skyfirstlabs.com,paulo@skyfirstlabs.com
CONSOLE_DEV_BYPASS=true
CONSOLE_DEV_BYPASS_EMAIL=gustavo.mendonca@skyfirstlabs.com

# Multi-tenant routing
# MULTI_TENANT_ENABLED=true ativa o TenantConnectionManager na request path.
# TENANT_DB_URL_TEMPLATE usa {db_name} (campo db_name da linha tenant_registry)
# para construir a URL de cada tenant sem precisar de AWS Secrets Manager.
# Formato: postgresql+asyncpg://<user>:<password>@<host>:<port>/{db_name}
MULTI_TENANT_ENABLED=true
TENANT_DB_URL_TEMPLATE=postgresql+asyncpg://postgres:postgres@localhost:5432/{db_name}
# Kubernetes — telemetria de infra
# STAGING: conecta via SSM Session Manager tunnel (127.0.0.1:6443)
#   O tunnel deve estar ativo: aws ssm start-session --target <bastion-id> --document-name AWS-StartPortForwardingSessionToRemoteHost
#   Ou via kubectl proxy já configurado no contexto 'staging'
KUBECONFIG_STAGING=/Users/thedatafirst/.kube/sky-stg-proxy.yaml
# PROD: cluster com private endpoint — acessível apenas dentro da VPC AWS (eu-west-1)
#   Em dev local: dados ficam vazios (gracioso). Em produção no cluster: funciona direto.
KUBECONFIG_PROD=/Users/thedatafirst/.kube/sky-prd.yaml

# Prometheus (staging) — port-forward local: kubectl -n monitoring port-forward svc/kube-prometheus-stack-prometheus 9090:9090
# Em produção no cluster: http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090
PROMETHEUS_URL=http://localhost:9090

# Grafana e ArgoCD URLs (usados nos links de infra do Console)
ARGOCD_BASE_URL=https://argocd-stg.skyfirstlabs.com
GRAFANA_BASE_URL=https://grafana-stg.skyfirstlabs.com

# AWS profile para o exec plugin do kubeconfig de staging
# O kubernetes Python client precisa desta var no ambiente para executar
# "aws eks get-token --profile sky-staging" corretamente
AWS_PROFILE=sky-staging
