# Development Environment Variables (Local - Fora do Docker)
# Este arquivo é para desenvolvimento local, mas usa PostgreSQL e Redis dos containers Docker

# Database - PostgreSQL do container Docker (porta 5433)
# O container está em deploy/docker-compose.yml
# NOTA: Senha com = precisa ser URL-encoded como %3D, mas alembic tem problema com isso
# Usando a senha diretamente aqui (funciona para asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:WalhCmMkKZLZIfP7IVkugENGiD8fySgrfzaB501vuIY=@localhost:5433/ai_saas_db

# Redis - Redis do container Docker (porta 6379)
# O container está em deploy/docker-compose.yml
REDIS_URL=redis://:htSqQwZPkuqk2mQeu2eWcdDTHvD0/MF4BbvqLAA67zc=@localhost:6379/0

# Celery (opcional para desenvolvimento)
CELERY_BROKER_URL=redis://:htSqQwZPkuqk2mQeu2eWcdDTHvD0/MF4BbvqLAA67zc=@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:htSqQwZPkuqk2mQeu2eWcdDTHvD0/MF4BbvqLAA67zc=@localhost:6379/2

# Backend
JWT_SECRET_KEY=4d8d6d98b07d013d3445a4cd0a1357a55207d4d734df83935b8342195c8a9254
ENCRYPTION_KEY=e3d0b5fc4337a324299294079aa7a4de974730a98749670ed276de49bb6c2d20
DEBUG=true
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO

# Sentry (opcional para desenvolvimento)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
